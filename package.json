{
  "name": "r-tunnel",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build:client": "esbuild src/main.tsx --bundle --platform=browser --format=esm --target=es2020 --minify --outfile=web/dist/bundle.js --define:process.env.NODE_ENV=\\\"production\\\"",
    "build:server": "esbuild server/src/server.ts --bundle --platform=node --format=esm --outfile=server.js --packages=external",
    "build:cli": "esbuild client/src/cli.ts --bundle --platform=node --format=esm --outfile=dist/client/cli.js --packages=external",
    "build": "npm run build:client && npm run build:server && npm run build:cli",
    "start": "node server.js",
    "test": "tsx tests/run-all.ts",
    "clean": "rm -rf dist server.js web/dist",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.21.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2"
  }
}
