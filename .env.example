# R-Tunnel Configuration Example

# Server Environment
NODE_ENV=production
# Render automatically injects PORT=10000
PORT=10000

# Public URLs and Domains
# On Render: RENDER_EXTERNAL_URL is automatically detected!
# You can also manually set: PUBLIC_BASE_URL="https://your-service.onrender.com"
PUBLIC_BASE_URL=
# Optional: Wildcard custom domain (e.g. *.tunnel.yourdomain.com)
PUBLIC_BASE_DOMAIN=

# Security & Session Secrets
# On Render Blueprint, SESSION_SECRET is automatically generated
SESSION_SECRET=

# Admin Authentication for Web Dashboard
ADMIN_USERNAME=admin
# On Render Blueprint, ADMIN_PASSWORD is automatically generated
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# Tunnel Client Authentication
# Master token required for Termux CLI client authentication
TUNNEL_MASTER_TOKEN=

# Render Free-Tier Keep-Alive
# Set to true to ping /health every 12 mins to prevent free tier sleep
KEEP_ALIVE=false

# Limits & Abuse Prevention
MAX_ACTIVE_TUNNELS=5
MAX_REQUESTS_PER_MINUTE=120
MAX_BODY_SIZE=10mb
MAX_WS_MESSAGE_SIZE=12mb

# Expiration & Timeouts
DEFAULT_TUNNEL_DURATION=1h
MAX_TUNNEL_DURATION=3h
IDLE_TIMEOUT_MINUTES=0

# Logging: debug | info | warn | error
LOG_LEVEL=info
