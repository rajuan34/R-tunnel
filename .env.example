# R-Tunnel Configuration Example

# Server Environment
NODE_ENV=production
PORT=10000

# Public URLs and Domains
# For Render: RENDER_EXTERNAL_URL is automatically detected, or set PUBLIC_BASE_URL
# e.g., PUBLIC_BASE_URL="https://r-tunnel.onrender.com"
PUBLIC_BASE_URL=
# If wildcard DNS is configured (e.g. *.tunnel.example.com), set PUBLIC_BASE_DOMAIN
# e.g., PUBLIC_BASE_DOMAIN="tunnel.example.com"
# If empty, path-based routing (e.g. /t/<tunnel-id>) is automatically used.
PUBLIC_BASE_DOMAIN=

# Admin Authentication for Web Dashboard
ADMIN_USERNAME=admin
# You can provide either plaintext password or bcrypt hash:
ADMIN_PASSWORD=
# Or generate bcrypt hash: e.g. node -e 'console.log(require("bcryptjs").hashSync("admin123", 10))'
ADMIN_PASSWORD_HASH=

# Tunnel Client Authentication
# Master token required for Termux CLI client authentication
TUNNEL_MASTER_TOKEN=

# Limits & Abuse Prevention
MAX_ACTIVE_TUNNELS=5
MAX_REQUESTS_PER_MINUTE=120
MAX_BODY_SIZE=10mb
MAX_WS_MESSAGE_SIZE=12mb

# Expiration & Timeouts
DEFAULT_TUNNEL_DURATION=1h
MAX_TUNNEL_DURATION=3h
IDLE_TIMEOUT_MINUTES=0

# Logging: debug | info | warn | error
LOG_LEVEL=info
